## Android Local Properties Template
## Copy this file to 'local.properties' and fill in your actual values
## IMPORTANT: local.properties is gitignored - never commit it!

# Android SDK location (update this to your actual SDK path)
sdk.dir=/Users/YOUR_USERNAME/Library/Android/sdk

# Mapbox Downloads Token
# Get your secret token from: https://account.mapbox.com/access-tokens/
# This is needed to download Mapbox SDK dependencies from Maven
MAPBOX_DOWNLOADS_TOKEN=sk.your_secret_token_here
